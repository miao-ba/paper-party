{
  "name": "paper-party",
  "version": "0.1.0",
  "description": "A tiny, hackable multiplayer party-game platform. One Node server, no accounts, add a game with one folder.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts --port 3330\" \"vite --host\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "new-game": "node scripts/new-game.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "qrcode-generator": "^1.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
